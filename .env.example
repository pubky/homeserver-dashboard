# Homeserver Dashboard environment variables
# Variables are server-only (read in API routes, never exposed to the browser),
# except the one NEXT_PUBLIC_* build-time flag documented at the bottom.
# For local development, copy this file to .env.local and update the values.

# --- Required: homeserver admin API -------------------------------------------

# Homeserver admin endpoint base URL.
# Example: http://localhost:6288 (local development)
# Example: http://homeserver:6288 (Docker/Umbrel - service name)
# Without it, the admin proxy, invites, users and the file browser fail.
ADMIN_BASE_URL=http://localhost:6288

# Admin password for the homeserver admin API. Also powers the password
# reveal (eye icon) in Settings. Optional when HOMESERVER_CONFIG_PATH points
# at a readable config.toml: unset, the dashboard uses its admin_password.
ADMIN_TOKEN=your-admin-password-here

# --- Optional: other homeserver endpoints -------------------------------------

# Homeserver client API base URL (API explorer's client group).
# CLIENT_BASE_URL=http://homeserver:6286

# Homeserver metrics base URL (API explorer's metrics group).
# METRICS_BASE_URL=http://homeserver:6289

# --- Optional: files shared with the homeserver -------------------------------

# Path to the homeserver's config.toml. Drives the Settings config editor
# (read AND write: saves are atomic tmp+rename), the Cloudflare disconnect
# domain reset, and restart-pending detection.
# Default: /app/homeserver-data/config.toml (Docker/Umbrel)
# HOMESERVER_CONFIG_PATH=/home/user/.pubky/data/config.toml

# Path to the homeserver's JSON-line log file. Unset = the Logs tab is
# disabled (/api/logs answers 503 and the tab shows as unavailable).
# HOMESERVER_LOG_PATH=/app/homeserver-data/logs/homeserver.log

# --- Optional: Cloudflare Tunnel -----------------------------------------------

# Directory holding the Cloudflare state files (token, domain, config.yml,
# credentials.json, preview markers). If missing or not writable, the
# Cloudflare tab reports the feature as unsupported.
# CLOUDFLARE_CONFIG_DIR=/app/cloudflare-config

# cloudflared binary used for the Connect (browser-auth) and Preview (quick
# tunnel) flows. The Docker image embeds it at the default path.
# CLOUDFLARED_BIN=/usr/local/bin/cloudflared

# Path at which the RUNTIME cloudflared container sees the shared config
# dir; baked into the generated config.yml (credentials-file line).
# CLOUDFLARED_RUNTIME_DIR=/etc/cloudflared-config

# Origin the instant preview quick tunnel forwards to.
# PREVIEW_INSTANT_ORIGIN=http://homeserver:6286

# Cloudflare API base URL. Override is for tests/e2e only.
# CF_API_BASE=https://api.cloudflare.com/client/v4

# --- Optional: platform flags ---------------------------------------------------

# Set to "true" by the Umbrel compose: rejects admin_password edits in the
# Settings config editor, because the platform injects that password and an
# edit would silently disconnect the dashboard from the homeserver.
# ADMIN_PASSWORD_MANAGED=true

# --- Optional: developer tools (build-time) -------------------------------------

# Show the "API" explorer tab. It's a developer tool, hidden by default; the
# production image is built without it. This is a NEXT_PUBLIC_* (build-time)
# flag, so set it before `npm run dev` / `npm run build` to see the tab.
# NEXT_PUBLIC_API_EXPLORER=true
