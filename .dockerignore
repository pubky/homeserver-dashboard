# Environment files - never include these in the build
.env
.env.local
.env.development
.env.production
.env.test
.env*.local

# Git / CI / agent state - never needed inside the image
.git
.gitignore
.github
.claude

# Dependencies
node_modules
npm-debug.log*

# Build outputs
.next
out
dist
coverage
tsconfig.tsbuildinfo

# Tests and dev tooling - `next build` never compiles these, and the
# runtime image only copies the bundle plus entrypoint.sh
**/*.test.*
vitest.config.ts
scripts
# ...except the two scripts the Dockerfile uses.
!scripts/migrate-cf-token.mjs
!scripts/bundle.mjs
docs

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Misc
*.md
!README.md
