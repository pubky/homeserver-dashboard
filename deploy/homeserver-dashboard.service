# Example unit: the systemd wrapper around the bundle, for a homeserver that
# itself runs as a plain systemd service on the same host. The README
# ("Deployment") has the install commands; the reason for each setting is here.
#
# Assumes the homeserver's user is `pubky`, its data directory is
# /home/pubky/.pubky, its ports are the default ones and Node.js 24+ is at
# /usr/bin/node. Edit to match your host.

[Unit]
Description=Pubky homeserver dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The homeserver's user, so the dashboard can read its config.toml.
User=pubky
Group=pubky
# The bundle: a copy of .next/standalone after `npm run bundle`.
WorkingDirectory=/opt/homeserver-dashboard
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production

# Who may sign in, with Pubky Ring: your pubky, or several separated by
# commas. With this set, every API route needs a signed-in admin. It ships
# empty, which lets nobody in: the dashboard stays closed until you fill it
# in. Delete the line only if something in front of the dashboard
# authenticates; without it there is no login at all.
Environment=ADMIN_PUBKEYS=

# Listen on loopback only, and reach it through an SSH tunnel or a TLS
# reverse proxy. Sign-in protects the dashboard; this keeps it off the
# network as well. Without HOSTNAME it listens on every interface.
Environment=HOSTNAME=127.0.0.1
Environment=PORT=8080

# Where the homeserver is. The admin password is deliberately not set here:
# without ADMIN_TOKEN the dashboard reads [admin] admin_password from the
# config.toml below, the file the homeserver itself takes it from, so the
# password lives in one place and stays out of this world-readable unit.
Environment=ADMIN_BASE_URL=http://127.0.0.1:6288
Environment=HOMESERVER_CONFIG_PATH=/home/pubky/.pubky/config.toml
# Only the API explorer tab uses these two, and it exists only in a bundle
# built with NEXT_PUBLIC_API_EXPLORER=true. Their built-in defaults are Docker
# service names (http://homeserver:...), which do not resolve on a plain host.
Environment=CLIENT_BASE_URL=http://127.0.0.1:6286
Environment=METRICS_BASE_URL=http://127.0.0.1:6289
# The Logs tab reads a file and stays hidden without one. A homeserver that
# only logs to journald has none; if yours also writes a log file, point at it.
#Environment=HOMESERVER_LOG_PATH=/home/pubky/.pubky/homeserver.log

Restart=on-failure
RestartSec=5
# server.js exits with 143 when it gets SIGTERM. Without this, every stop or
# restart is recorded as a failure and `systemctl stop` leaves the unit failed.
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Keeps /home read-only, so Settings shows config.toml but cannot save it.
# To allow editing, add `ReadWritePaths=` with the homeserver's data directory.
ProtectHome=read-only
# Read-only still means readable, and this process runs as the homeserver's
# user. Hide the homeserver's key, which the dashboard never needs. The `-`
# ignores a missing file.
InaccessiblePaths=-/home/pubky/.pubky/secret

[Install]
WantedBy=multi-user.target
